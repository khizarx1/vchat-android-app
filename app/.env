# Base URL the app uses to reach the backend API (note the /api suffix).
# Pick the line matching how you run the app, then RESTART expo (env is baked in at bundle time):
#   Web / iOS simulator:                          http://localhost:4000/api
#   Android emulator:                             http://10.0.2.2:4000/api
#   Physical phone (Expo Go), same Wi-Fi as PC:   http://192.168.2.2:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
